rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /password_otps/{docId} {
      allow read, write: if false;
    }

    // User accounts (username → Firebase UID + hashed password/secret).
    // Unauthenticated clients cannot read hashes. Recovery goes through Cloud Functions.
    match /users/{username} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.firebaseUid
        && request.resource.data.usernameLower == username
        && request.resource.data.keys().hasAll([
          'username', 'usernameLower', 'firebaseUid',
          'passwordSalt', 'passwordHash', 'secretSalt', 'secretHash',
          'email', 'emailLower'
        ]);
      allow update, read: if request.auth != null
        && request.auth.uid == resource.data.firebaseUid;
      allow delete: if false;
    }

    // Real email uniqueness index (doc id = emailLower).
    // create only — overwrite of another account's email is denied (surfaces as duplicate).
    match /emailIndex/{email} {
      // Allow get on missing docs so clients can verify uniqueness; existing docs stay private.
      allow get: if request.auth != null
        && (resource == null || request.auth.uid == resource.data.firebaseUid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.firebaseUid
        && request.resource.data.keys().hasAll(['username', 'firebaseUid', 'email']);
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.firebaseUid;
    }
  }
}
